lemma seven_basis_momentum_bound (t : HamiltonianParameters K) (k : Fin 13) :
    Bounded ![0, 1] 6 (sevenBasis t k) := by
  change sevenBasis t k ∈ boundedSubmodule ![0, 1] 6
  fin_cases k <;> norm_num only [sevenBasis]
  all_goals repeat' apply (boundedSubmodule (K := K) ![0, 1] 6).add_mem
  all_goals exact bounded_monomial _ _ _ _ _ (by norm_num)

lemma seven_combination_static (t : HamiltonianParameters K)
    (hb : t.b₃ = 0) (h4 : t.c₄ = 0) (h5 : t.c₅ = 0) (x : Fin 13 → K) :
    Static t.toGateParameters (sevenCombination t x) := by
  apply (staticSubmodule t.toGateParameters).sum_mem
  intro k _
  rw [C_mul']
  exact (staticSubmodule t.toGateParameters).smul_mem _ (seven_basis_static t hb h4 h5 k)

lemma seven_combination_momentum_bound (t : HamiltonianParameters K) (x : Fin 13 → K) :
    Bounded ![0, 1] 6 (sevenCombination t x) := by
  apply (boundedSubmodule (K := K) ![0, 1] 6).sum_mem
  intro k _
  rw [C_mul']
  exact (boundedSubmodule (K := K) ![0, 1] 6).smul_mem _ (seven_basis_momentum_bound t k)

@[simp] lemma bicoeff_sum {ι : Type*} (s : Finset ι) (f : ι → Poly K) (i j : ℕ) :
    bicoeff i j (∑ k ∈ s, f k) = ∑ k ∈ s, bicoeff i j (f k) := by
  simp [bicoeff, coeff_sum]

