    monomial (exponent 5 0) (((-6) * t.b₁) + ((-6) * t.c₃)) +
    monomial (exponent 4 1) (10 * t.b₂) +
    monomial (exponent 3 1) ((20 * t.b₁) + (20 * t.c₃)) +
    monomial (exponent 0 4) 5) = if (0,4) = (i,j) then ((5 : ℕ) : K) else 0
    simp only [Prod.mk.injEq]
    simp [bicoeff_monomial, hn 3 (by omega), hn 4 (by omega), hn 5 (by omega), hn 6 (by omega), hn 7 (by omega), hn 8 (by omega), hn 9 (by omega), hn 10 (by omega)]
  · change bicoeff i j (monomial (exponent 8 0) (9 * t.b₂) +
    monomial (exponent 7 0) ((36 * t.b₁) + (36 * t.c₃)) +
    monomial (exponent 6 1) ((-84) * t.b₂) +
    monomial (exponent 6 0) ((-7) * (t.b₂ ^ 2)) +
    monomial (exponent 5 1) (((-252) * t.b₁) + ((-252) * t.c₃)) +
    monomial (exponent 5 0) (((-21) * t.b₁ * t.b₂) + ((-21) * t.b₂ * t.c₃)) +
    monomial (exponent 4 2) (105 * t.b₂) +
    monomial (exponent 3 2) ((210 * t.b₁) + (210 * t.c₃)) +
    monomial (exponent 0 5) 21) = if (0,5) = (i,j) then ((21 : ℕ) : K) else 0
    simp only [Prod.mk.injEq]
    simp [bicoeff_monomial, hn 3 (by omega), hn 4 (by omega), hn 5 (by omega), hn 6 (by omega), hn 7 (by omega), hn 8 (by omega), hn 9 (by omega), hn 10 (by omega)]
  · change bicoeff i j (monomial (exponent 10 0) ((-36) * t.b₂) +
    monomial (exponent 9 0) (((-180) * t.b₁) + ((-180) * t.c₃)) +
    monomial (exponent 8 1) (540 * t.b₂) +
    monomial (exponent 8 0) (85 * (t.b₂ ^ 2)) +
    monomial (exponent 7 1) ((2160 * t.b₁) + (2160 * t.c₃)) +
    monomial (exponent 7 0) ((340 * t.b₁ * t.b₂) + (340 * t.b₂ * t.c₃)) +
    monomial (exponent 6 2) ((-1260) * t.b₂) +
    monomial (exponent 6 1) ((-140) * (t.b₂ ^ 2)) +
    monomial (exponent 6 0) ((70 * (t.b₁ ^ 2)) + (70 * (t.c₃ ^ 2)) + (140 * t.b₁ * t.c₃)) +
    monomial (exponent 5 2) (((-3780) * t.b₁) + ((-3780) * t.c₃)) +
    monomial (exponent 5 1) (((-420) * t.b₁ * t.b₂) + ((-420) * t.b₂ * t.c₃)) +
    monomial (exponent 4 3) (700 * t.b₂) +
    monomial (exponent 3 3) ((1400 * t.b₁) + (1400 * t.c₃)) +
    monomial (exponent 0 6) 70) = if (0,6) = (i,j) then ((70 : ℕ) : K) else 0
    simp only [Prod.mk.injEq]
    simp [bicoeff_monomial, hn 3 (by omega), hn 4 (by omega), hn 5 (by omega), hn 6 (by omega), hn 7 (by omega), hn 8 (by omega), hn 9 (by omega), hn 10 (by omega)]

lemma seven_combination_initial (t : HamiltonianParameters K) (x : Fin 13 → K)
    (i j : ℕ) (hi : i < 3) (_hj : j ≤ 6) :
    bicoeff i j (sevenCombination t x) =
      ∑ k : Fin 13, if sevenIndices k = (i,j) then (sevenScales k : K)*x k else 0 := by
  simp only [sevenCombination, bicoeff_sum, bicoeff_C_mul, seven_basis_initial t _ i j hi]
  apply Finset.sum_congr rfl
  intro k _
  split_ifs <;> simp [mul_comm]

lemma seven_scales_ne_zero (k : Fin 13) : (sevenScales k : K) ≠ 0 := by
  fin_cases k <;> norm_num [sevenScales]

